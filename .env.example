# PostgreSQL + PostGIS (production / Docker / Supabase)
# Leave unset in local dev without Docker to use sqlite+aiosqlite:///./aed_registry.db
DATABASE_URL=postgresql+asyncpg://aed:aed_dev_password@localhost:5432/aed_registry

# Spatial deduplication radius in meters
DEDUP_RADIUS_M=25

# Live OSM Overpass endpoint
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API target (blank in Vite dev mode to use /api proxy)
VITE_API_BASE_URL=
